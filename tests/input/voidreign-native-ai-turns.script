# Let native computer empires play five turns from a VOIDREIGN quick start.
# This exercises their native faction AI profiles, design ministers, research and economy.
options --quick-start=Aurelian --empires=3 --systems=24 --seed=7 --turns=5 --open=none --layout=1024x768 --size=1280x800

wait-screen game
assert-turn 5
wait 5

# The player's opening patrol and warehouse-backed homeworld must remain valid
# after five turns of computer-player activity.
click sector:home
wait-for item:report:fleet
click item:report:fleet
wait-for item:report:fleet-member
assert { selected = "fleet", design_type = "Attack Ship" }
key Escape
click sector:home
wait-for item:Facil
click item:Facil
wait-for item:"VoidReign Warehouse"
assert-present item:"VoidReign Spaceport"
assert-present item:"VoidReign Warehouse"
assert-present item:"VoidReign Planetary Shipyard"
assert-present item:"VoidReign Supply Depot"
