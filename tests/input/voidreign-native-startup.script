# Play a fresh game from VOIDREIGN's own shipped ruleset, not a mod or the test fixtures.
# This verifies the native faction can start, fields a movable Attack Ship in its Home Patrol,
# and places the native spaceport and warehouse on the starting colony.

options --quick-start=Aurelian --empires=3 --systems=24 --seed=7 --open=none --layout=1024x768 --size=1280x800

wait-screen game
wait 5
# The home sector contains the automatically created Home Patrol fleet.
click sector:home
wait-for item:report:fleet
click item:report:fleet
wait-for item:report:fleet-member
assert { selected = "fleet", design_type = "Attack Ship" }
key Escape
wait 5
click sector:home
wait-for item:Facil
click item:Facil
wait-for item:"VoidReign Warehouse"
assert-present item:"VoidReign Spaceport"
assert-present item:"VoidReign Warehouse"
assert-present item:"VoidReign Planetary Shipyard"
assert-present item:"VoidReign Supply Depot"

# The homeworld must be able to produce a ship, not just own a fleet.
key Escape
click tag:command:queues
wait-window queues
click item:##row in=queues
wait-window set-queue
click item:Ships in=set-queue
wait-for item:##row in=set-queue
click item:##row in=set-queue
wait 2
assert { command = "QueueAdd" }
assert { construction_queued = 1 }

# The native AI design minister also creates a Base Space Yard using the
# Orbital Station hull and Orbital Shipyard component. Queue that station.
wait-for item:"Accord II" in=set-queue
assert-inside item:"Accord II" in=set-queue tag:set-queue:available:named
click item:"Accord II" in=set-queue
wait 2
assert { command = "QueueAdd", design_type = "Base Space Yard" }
assert { construction_queued = 2 }
key Escape
wait-closed set-queue
key Escape
wait-closed queues

# Exercise a real native research order and process the first turn.
click tag:command:research
wait-window research
click item:* in=research nth=1
wait 2
assert { research_queued = 1 }
key Escape
wait-closed research
click tag:button:end-turn
click item:Yes in="End Turn"
wait-turn 1
assert-turn 1
click tag:log:close optional
assert-turn 1
