# Play a fresh game from VOIDREIGN's own shipped ruleset, not a mod or the test fixtures.
# This verifies the native faction can start, fields a movable Attack Ship in its Home Patrol,
# and places the native spaceport and warehouse on the starting colony.

options --quick-start=Aurelian --empires=3 --systems=24 --seed=7 --open=none --layout=1024x768 --size=1280x800

wait-screen game
wait 5
# The home sector contains the automatically created Home Patrol fleet.
click sector:home
wait-for item:report:fleet
click item:report:fleet
wait-for item:report:fleet-member
assert { selected = "fleet", design_type = "Attack Ship" }
key Escape
wait 5
click sector:home
wait-for item:Facil
click item:Facil
wait-for item:"VoidReign Warehouse"
assert-present item:"VoidReign Spaceport"
assert-present item:"VoidReign Warehouse"
